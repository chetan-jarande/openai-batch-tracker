# Use an official Python runtime as a parent image
FROM python:3.13.3-slim

# Set environment variables to prevent .pyc files and buffer issues
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Set the working directory
WORKDIR /app

# Create a virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip and install uv
RUN pip install --upgrade pip uv

# Install make and Node.js
RUN apt-get update -o Acquire::Retries=3 && \
    # Install prerequisites for adding custom repositories
    apt-get install -y ca-certificates curl gnupg make --no-install-recommends && \
    # Add NodeSource GPG key
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    # Add NodeSource repository for Node.js 24.x (LTS)
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    # Update package lists again and install nodejs
    apt-get update -o Acquire::Retries=3 && \
    apt-get install -y nodejs --no-install-recommends && \
    # Clean up
    rm -rf /var/lib/apt/lists/*

# Copy files required for package installation
COPY pyproject.toml .
COPY README.md .
COPY LICENSE .
COPY Makefile .

# Install all dependencies, including the [dev] extras
RUN uv pip install --no-cache-dir '.[dev]'

# Copy the application source code
# This is done so the container can run without a volume mount if needed,
# but the docker-compose setup will mount over this.
COPY ./app /app/app
COPY ./app/templates /app/templates

# Create a non-root user for better security
RUN groupadd -r appuser && useradd -r -g appuser appuser
RUN chown -R appuser:appuser /app

# Switch to the non-root user
USER appuser

# Expose the port the app runs on
EXPOSE 8000

# Define the command to run the application using the Makefile
CMD ["make", "run"]
