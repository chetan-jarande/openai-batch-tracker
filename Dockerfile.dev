# Use an official Python runtime as a parent image
FROM python:3.13.3-slim

# Set environment variables to prevent .pyc files and buffer issues
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Set the working directory
WORKDIR /app

# Create a virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip and install uv
RUN pip install --upgrade pip uv

# Install make so the CMD can be executed
RUN apt-get update && apt-get install -y make --no-install-recommends && rm -rf /var/lib/apt/lists/*

# Copy files required for package installation
COPY pyproject.toml .
COPY README.md .
COPY LICENSE .
COPY Makefile .

# Install all dependencies, including the [dev] extras
RUN uv pip install --no-cache-dir '.[dev]'

# Copy the application source code
# This is done so the container can run without a volume mount if needed,
# but the docker-compose setup will mount over this.
COPY ./app /app/app
COPY ./app/templates /app/templates

# Create a non-root user for better security
RUN groupadd -r appuser && useradd -r -g appuser appuser
RUN chown -R appuser:appuser /app

# Switch to the non-root user
USER appuser

# Expose the port the app runs on
EXPOSE 8000

# Define the command to run the application using the Makefile
CMD ["make", "run"]
